{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/discord",
      "destination": "/.well-known/discord"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/discord",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
